# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.tmp
.env.*.local
!.env.example

# sqlite and local runtime files
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/*.sqlite*
/data/*.log
/data/backups/
*.db-wal
*.db-shm
*.sqlite*
*.traineddata
/prisma/*.db
/prisma/*.db-journal

# local agent browser traces
.playwright-mcp/
.playwright-cli/
/data/ui-*.png
agent-tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
