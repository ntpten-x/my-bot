{
  "name": "my-bot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/start-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "dev:web": "next dev -p 8001",
    "db:renormalize": "tsx scripts/renormalize-posts.ts",
    "db:backfill-embeddings": "tsx scripts/backfill-embeddings.ts",
    "db:backfill-ai": "tsx scripts/backfill-ai.ts",
    "db:clean-samples": "tsx scripts/clean-samples.ts",
    "dev:worker": "tsx src/worker/index.ts",
    "build": "prisma generate && next build",
    "start": "node scripts/start-all.mjs --prod",
    "start:prod": "node scripts/start-all.mjs --prod",
    "setup": "node scripts/setup.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.1.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
