{
  "name": "my-bot",
  "version": "1.3.7",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/start-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "dev:web": "next dev -p 8001",
    "browser:bot": "node scripts/start-bot-browser.mjs",
    "browser:desktop": "bash scripts/start-bot-desktop.sh",
    "bot:start": "bash scripts/start-workstation.sh --start",
    "bot:status": "bash scripts/start-workstation.sh --status",
    "bot:stop": "bash scripts/start-workstation.sh --stop",
    "bot:resume-desktop": "bash scripts/start-workstation.sh --resume-desktop",
    "bot:install-service": "node scripts/install-workstation-service.mjs --install",
    "bot:uninstall-service": "node scripts/install-workstation-service.mjs --remove",
    "bot:install-worker": "node scripts/install-worker-service.mjs --install",
    "bot:uninstall-worker": "node scripts/install-worker-service.mjs --remove",
    "db:renormalize": "tsx scripts/renormalize-posts.ts",
    "db:backfill-embeddings": "tsx scripts/backfill-embeddings.ts",
    "db:backfill-ai": "tsx scripts/backfill-ai.ts",
    "db:clean-samples": "tsx scripts/clean-samples.ts",
    "dev:worker": "tsx src/worker/index.ts",
    "build": "prisma generate && next build",
    "start": "node scripts/start-all.mjs --prod",
    "start:prod": "node scripts/start-all.mjs --prod",
    "setup": "node scripts/setup.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate:classifier": "tsx scripts/evaluate-classifier.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-backup.ts",
    "db:migrate-from-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "postinstall": "prisma generate",
    "readiness": "tsx scripts/readiness.ts",
    "observe:automation": "node scripts/observe-automation.mjs",
    "test:production": "node scripts/smoke-production-local.mjs",
    "test:auth-production": "node scripts/smoke-auth-local.mjs",
    "verify:collection-soak": "node scripts/verify-collection-soak.mjs",
    "verify:comment-acceptance": "node scripts/verify-comment-acceptance.mjs",
    "test:ci": "node scripts/test-ci.mjs",
    "db:encrypt-settings": "tsx scripts/encrypt-settings.ts",
    "security:check": "tsx scripts/security-readiness.ts",
    "security:cutover": "tsx scripts/security-cutover.ts",
    "security:audit": "tsx scripts/verify-security-audit.ts",
    "security:restore-drill": "tsx scripts/restore-drill.ts",
    "profile:reads": "tsx scripts/profile-read-queries.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.6.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.1.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "next": {
      "postcss": "8.5.32"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "optionalDependencies": {
    "lightningcss": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
