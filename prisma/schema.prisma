generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Owner {
  id           String    @id @default(cuid())
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Source {
  id                     String      @id @default(cuid())
  type                   String
  name                   String
  url                    String      @unique
  enabled                Boolean     @default(true)
  lastFetchedAt          DateTime?
  lastExtensionAt        DateTime?
  lastError              String?
  intervalMinutes        Int         @default(10)
  // Read-only scrape scheduling (extension): priority high|normal|low, adaptive interval, last-run stats.
  priority               String      @default("normal")
  currentIntervalMinutes Float       @default(10)
  nextRunAt              DateTime?
  lastRunAt              DateTime?
  lastRunFound           Int         @default(0)
  lastRunNew             Int         @default(0)
  lastRunScrolls         Int         @default(0)
  lastRunStop            String      @default("")
  /// Numeric Facebook group id seen on the page (vanity URLs resolve to it).
  fbGroupId              String?
  /// Owner binding: top-level category slug and default product for this group ("" / null = auto from last 30 days).
  boundCategorySlug      String      @default("")
  defaultProductId       String?
  defaultProduct         Product?    @relation("SourceDefaultProduct", fields: [defaultProductId], references: [id], onDelete: SetNull)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  posts                  Post[]
  fetchLogs              FetchLog[]
  fetchTasks             FetchTask[]
  scrapeRuns             ScrapeRun[]

  @@index([fbGroupId])
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  parentId   String?
  parent     Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CatTree")
  matchWords String     @default("")
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  posts      Post[]     @relation("PostCategory")
  subPosts   Post[]     @relation("PostSubcategory")
}

/// Level 3 of the taxonomy: a game or product inside a top-level category (Roblox, ROV, iPhone…).
model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  nameEn       String   @default("")
  categorySlug String
  /// Comma-separated keyword aliases matched after normalisation.
  aliases      String   @default("")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posts        Post[]
  sources      Source[] @relation("SourceDefaultProduct")
  templates    ReplyTemplate[]

  @@index([categorySlug, sortOrder])
}

model Post {
  id               String            @id @default(cuid())
  sourceId         String
  source           Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalUrl      String
  authorName       String            @default("")
  text             String
  normalizedText   String
  contentHash      String            @unique
  textRevision     Int               @default(0)
  postedAt         DateTime?
  /// Generated column COALESCE(postedAt, createdAt); never write it.
  sortAt           DateTime?
  imagesJson       String            @default("[]")
  categoryId       String?
  category         Category?         @relation("PostCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId    String?
  subcategory      Category?         @relation("PostSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  intent           String            @default("unknown")
  productId        String?
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// How productId was set: rules | ai | group | owner | none ("" = not checked yet).
  productBy        String            @default("")
  province         String?
  isAd             Boolean           @default(false)
  keywordHitsJson  String            @default("[]")
  forbiddenHit     Boolean           @default(false)
  isRead           Boolean           @default(false)
  isSaved          Boolean           @default(false)
  pipelineStatus   String            @default("none")
  suggestedReply   String            @default("")
  aiProvider       String?
  score            Int               @default(0)
  scoreReason      String            @default("")
  embeddingJson    String            @default("")
  embeddingKey     String            @default("")
  embeddingConfig  String            @default("")
  embeddingRetryAt DateTime          @default("1970-01-01T00:00:00.000Z")
  duplicateOfId    String?
  dismissed        Boolean           @default(false)
  ocrText          String            @default("")
  extraUrlsJson    String            @default("[]")
  /// Stored text was cut off at "See more"; the extension re-reads the permalink.
  truncated        Boolean           @default(false)
  refetchAttempts  Int               @default(0)
  refetchAfter     DateTime?
  followUpAt       DateTime?
  statusChangedAt  DateTime?
  repliedAt        DateTime?
  replyItem        ReplyQueueItem?
  aiJobs           AiJob[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notes            Note[]
  notifications    Notification[]
  feedback         Feedback[]
  labelFixes       LabelCorrection[]
  autoCommentJobs  AutoCommentJob[]

  @@unique([sourceId, externalUrl])
  @@index([createdAt])
  @@index([sortAt(sort: Desc)])
  @@index([isRead])
  @@index([pipelineStatus])
  @@index([province])
  @@index([score])
  @@index([normalizedText], type: Hash)
  @@index([sourceId, duplicateOfId, createdAt])
  @@index([embeddingConfig, embeddingRetryAt])
  @@index([followUpAt])
  @@index([duplicateOfId])
  @@index([sourceId, truncated])
  @@index([productId, createdAt])
  @@index([productBy])
}

model AiJob {
  id            String   @id @default(cuid())
  postId        String   @unique
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String   @default("")
  claimToken    String?
  latencyMs     Int?
  queueWaitMs   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, updatedAt])
}

model OcrCache {
  imageHash String   @id
  text      String
  provider  String
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PreferenceWeight {
  id        String   @id @default(cuid())
  kind      String
  key       String
  weight    Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
}

model Summary {
  id        String   @id @default(cuid())
  day       String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Keyword {
  id        String   @id @default(cuid())
  word      String
  type      String
  createdAt DateTime @default(now())

  @@unique([word, type])
}

model Note {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  channel   String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  provider  String
  result    String
  createdAt DateTime @default(now())
}

model FetchTask {
  id         String    @id @default(cuid())
  mode       String    @default("scrape")
  sourceId   String
  source     Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     String    @default("pending")
  message    String    @default("")
  postsFound Int       @default(0)
  createdAt  DateTime  @default(now())
  pickedAt   DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

model ParseSample {
  id        String   @id @default(cuid())
  sourceUrl String
  payload   String
  postCount Int      @default(0)
  createdAt DateTime @default(now())
}

model FetchLog {
  id         String   @id @default(cuid())
  sourceId   String?
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  status     String
  message    String   @default("")
  postsFound Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ReplyTemplate {
  id         String   @id @default(cuid())
  name       String
  body       String
  categoryId String?
  /// Game/product scope (level 3); null = any product.
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Comma-separated Source ids; "" = every group.
  sourceIds  String   @default("")
  sortOrder  Int      @default(0)
  useCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AutomationRule {
  id            String    @id @default(cuid())
  name          String
  enabled       Boolean   @default(true)
  categoryId    String?
  keywords      String    @default("")
  provinces     String    @default("")
  intent        String    @default("")
  minScore      Int       @default(0)
  actionNotify  Boolean   @default(true)
  actionSave    Boolean   @default(false)
  actionDismiss Boolean   @default(false)
  templateId    String?
  /// ชุดตอบกลับ/กฎการเม้น: extra conditions (all optional).
  subcategoryId   String?
  productId       String?
  /// Comma-separated Source ids; "" = every group.
  sourceIds       String  @default("")
  excludeKeywords String  @default("")
  /// 0 = no limit (queue still only looks back 24 h unless a rule asks for more, max 168).
  maxAgeHours     Int     @default(0)
  /// Lower runs first when a post matches several queue rules.
  priority        Int     @default(0)
  /// Put matching posts into the assisted reply queue (owner still presses send).
  actionQueue     Boolean @default(false)
  /// Comma-separated explicit template ids; "" = auto (group/product-scoped set).
  templateIds     String  @default("")
  hitCount      Int       @default(0)
  lastHitAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hits          RuleHit[]
}

model RuleHit {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime       @default(now())

  @@unique([ruleId, postId])
  @@index([postId])
}

// Assisted-reply queue: MY-BOT fills a draft and opens the post; the owner presses send.
model ReplyQueueItem {
  id         String    @id @default(cuid())
  postId     String    @unique
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  sourceId   String
  authorKey  String    @default("")
  templateId String?
  /// AutomationRule that queued it (null = default queue filters).
  ruleId     String?
  text       String
  day        String
  status     String    @default("queued")
  openedAt   DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([day, status])
  @@index([status, createdAt])
  @@index([authorKey, createdAt])
}

// Facebook accounts seen by the read-only extension (id = the c_user value on facebook.com).
model FbAccount {
  id            String   @id
  name          String   @default("")
  browser       String   @default("")
  profileLabel  String   @default("")
  installId     String   @default("")
  loggedIn      Boolean  @default(true)
  postsCaptured Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lastSeenAt])
}

// One row per extension install (random id kept in chrome.storage). Updated every minute.
model ExtensionHeartbeat {
  id            String    @id
  version       String    @default("")
  browser       String    @default("")
  profileLabel  String    @default("")
  enabled       Boolean   @default(false)
  fbLoggedIn    Boolean   @default(false)
  fbUserId      String?
  fbUserName    String    @default("")
  fbCheckedAt   DateTime?
  tabsJson      String    @default("[]")
  lastError     String    @default("")
  lastErrorAt   DateTime?
  lastPostAt    DateTime?
  postsSent     Int       @default(0)
  errorCount24h Int       @default(0)
  errorLogJson  String    @default("[]")
  outboxSize    Int       @default(0)
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([lastSeenAt])
}

// AI providers the owner manages on /settings/ai-providers. Tried in priority order;
// one that hits a limit cools down and the router moves to the next.
model AiProvider {
  id             String    @id @default(cuid())
  name           String
  preset         String    @default("custom")
  kind           String    @default("openai")
  baseUrl        String    @default("")
  model          String    @default("")
  apiKeyEnc      String?
  apiKeyHint     String?
  enabled        Boolean   @default(true)
  priority       Int       @default(100)
  tasks          String    @default("classify")
  limitPerMinute Int?
  limitPerDay    Int?
  resetHourUtc   Int       @default(0)
  origin         String    @default("user")
  usageDay       String?
  requestsToday  Int       @default(0)
  tokensToday    Int       @default(0)
  requestsTotal  Int       @default(0)
  tokensTotal    Int       @default(0)
  errorsTotal    Int       @default(0)
  lastLatencyMs  Int?
  lastUsedAt     DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  cooldownUntil  DateTime?
  cooldownReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([priority])
}

model ExtensionPairingCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ExtensionDevice {
  id         String    @id @default(cuid())
  name       String    @default("")
  tokenHash  String    @unique
  tokenHint  String    @default("")
  version    String    @default("")
  lastSeenAt DateTime?
  lastIp     String    @default("")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model LoginGuard {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// One read-only extension run, for coverage stats ("are we missing posts?").
model ScrapeRun {
  id           String   @id @default(cuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  mode         String   @default("normal")
  ok           Boolean  @default(true)
  found        Int      @default(0)
  fresh        Int      @default(0)
  inserted     Int      @default(0)
  scrolls      Int      @default(0)
  stoppedBy    String   @default("")
  reachedKnown Boolean  @default(false)
  hitLimit     Boolean  @default(false)
  stalls       Int      @default(0)
  usedWindow   Boolean  @default(false)
  windowState  String   @default("")
  reloaded     Boolean  @default(false)
  stallsFirst  Int      @default(0)
  stallsRetry  Int      @default(0)
  throttled    Boolean  @default(false)
  fullTried    Int      @default(0)
  fullOk       Int      @default(0)
  durationMs   Int      @default(0)
  extVersion   String   @default("")

  @@index([sourceId, createdAt])
}

// Leader lease: local and Render share this DB; only the holder runs background jobs.
model Lease {
  name      String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// Idempotency keys: an alert or summary with the same key is sent once.
// Dedupe record for a post removed by retention, so the same post is not stored or alerted again.
model PostTombstone {
  contentHash String   @id
  sourceId    String
  externalUrl String
  createdAt   DateTime @default(now())

  @@index([sourceId, externalUrl])
  @@index([createdAt])
}

/// Owner pressed "หมวดผิด" and picked the right label: ground truth for per-group accuracy.
model LabelCorrection {
  id              String   @id @default(cuid())
  postId          String
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  sourceId        String
  fromCategory    String   @default("")
  fromSubcategory String   @default("")
  fromIntent      String   @default("")
  fromProvider    String   @default("")
  toCategory      String   @default("")
  toSubcategory   String   @default("")
  toIntent        String   @default("")
  fromProduct     String   @default("")
  toProduct       String   @default("")
  createdAt       DateTime @default(now())

  @@index([sourceId, createdAt])
  @@index([postId])
}

model SentKey {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AutoCommentRule {
  id               String   @id @default(cuid())
  name             String
  enabled          Boolean  @default(false)
  revision         Int      @default(1)
  sourceIdsJson    String   @default("[]")
  keywords         String   @default("")
  excludeKeywords  String   @default("")
  keywordMode      String   @default("any")
  selectionMode    String   @default("sequential")
  nextTemplate     Int      @default(0)
  startMinute      Int      @default(0)
  endMinute        Int      @default(1440)
  daysJson         String   @default("[0,1,2,3,4,5,6]")
  maxAgeHours      Int      @default(24)
  areaCooldownSec  Int      @default(300)
  pageId           String   @default("")
  deliveryMode     String   @default("official")
  browserDeviceId  String   @default("")
  browserFbUserId  String   @default("")
  browserConsent   Boolean  @default(false)
  requireAi        Boolean  @default(false)
  messageMode      String   @default("template")
  pageTokenEnc     String?
  managerTokenEnc  String?
  pausedReason     String   @default("")
  lastPolledAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  templates        AutoCommentTemplate[]
  jobs             AutoCommentJob[]
  logs             AutoCommentLog[]

  @@index([enabled, createdAt])
}

model AutoCommentTemplate {
  id        String   @id @default(cuid())
  ruleId    String
  rule      AutoCommentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([ruleId, sortOrder])
}

model AutoCommentJob {
  id              String   @id @default(cuid())
  ruleId          String
  rule            AutoCommentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  postId          String?
  post            Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  dedupeKey       String   @unique
  postKey         String
  externalUrl     String
  sourceId        String
  pageId          String   @default("")
  deliveryMode    String   @default("official")
  browserDeviceId String   @default("")
  browserFbUserId String   @default("")
  remotePostId    String   @default("")
  ruleRevision    Int
  textRevision    Int
  generation      String
  dryRun          Boolean  @default(true)
  message         String
  status          String   @default("pending")
  attempts        Int      @default(0)
  claimToken      String?
  claimUntil      DateTime?
  nextAttemptAt   DateTime @default(now())
  dispatchedAt    DateTime?
  remoteCommentId String?
  lastError       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  logs            AutoCommentLog[]

  @@index([status, nextAttemptAt])
  @@index([deliveryMode, browserDeviceId, status, nextAttemptAt], map: "AutoCommentJob_browser_queue_idx")
  @@index([sourceId, dispatchedAt])
  @@index([pageId, dispatchedAt])
  @@index([generation, status])
  @@index([postId])
}

model AutoCommentLog {
  id        String   @id @default(cuid())
  ruleId    String?
  rule      AutoCommentRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  jobId     String?
  job       AutoCommentJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  eventKey  String?  @unique
  event     String
  message   String   @default("")
  pageId    String   @default("")
  sourceId  String   @default("")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([pageId, event, createdAt])
  @@index([sourceId, event, createdAt])
  @@index([jobId])
}
