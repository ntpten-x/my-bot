generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Owner {
  id           String    @id @default(cuid())
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Source {
  id              String      @id @default(cuid())
  type            String
  name            String
  url             String      @unique
  enabled         Boolean     @default(true)
  lastFetchedAt   DateTime?
  lastExtensionAt DateTime?
  lastError       String?
  intervalMinutes Int         @default(10)
  // Read-only scrape scheduling (extension): priority high|normal|low, adaptive interval, last-run stats.
  priority               String    @default("normal")
  currentIntervalMinutes Float     @default(10)
  nextRunAt              DateTime?
  lastRunAt              DateTime?
  lastRunFound           Int       @default(0)
  lastRunNew             Int       @default(0)
  lastRunScrolls         Int       @default(0)
  lastRunStop            String    @default("")
  /// Numeric Facebook group id seen on the page (vanity URLs resolve to it).
  fbGroupId              String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  posts           Post[]
  fetchLogs       FetchLog[]
  fetchTasks      FetchTask[]

  @@index([fbGroupId])
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  parentId   String?
  parent     Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CatTree")
  matchWords String     @default("")
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  posts      Post[]     @relation("PostCategory")
  subPosts   Post[]     @relation("PostSubcategory")
}

model Post {
  id               String          @id @default(cuid())
  sourceId         String
  source           Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalUrl      String
  authorName       String          @default("")
  text             String
  normalizedText   String
  contentHash      String          @unique
  postedAt         DateTime?
  /// Generated column COALESCE(postedAt, createdAt); never write it.
  sortAt           DateTime?
  imagesJson       String          @default("[]")
  categoryId       String?
  category         Category?       @relation("PostCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId    String?
  subcategory      Category?       @relation("PostSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  intent           String          @default("unknown")
  province         String?
  isAd             Boolean         @default(false)
  keywordHitsJson  String          @default("[]")
  forbiddenHit     Boolean         @default(false)
  isRead           Boolean         @default(false)
  isSaved          Boolean         @default(false)
  pipelineStatus   String          @default("none")
  suggestedReply   String          @default("")
  aiProvider       String?
  score            Int             @default(0)
  scoreReason      String          @default("")
  embeddingJson    String          @default("")
  embeddingKey     String          @default("")
  embeddingConfig  String          @default("")
  embeddingRetryAt DateTime        @default("1970-01-01T00:00:00.000Z")
  duplicateOfId    String?
  dismissed        Boolean         @default(false)
  ocrText          String          @default("")
  extraUrlsJson    String          @default("[]")
  followUpAt       DateTime?
  statusChangedAt  DateTime?
  repliedAt        DateTime?
  replyItem        ReplyQueueItem?
  aiJobs           AiJob[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  notes            Note[]
  notifications    Notification[]
  feedback         Feedback[]

  @@unique([sourceId, externalUrl])
  @@index([createdAt])
  @@index([sortAt(sort: Desc)])
  @@index([isRead])
  @@index([pipelineStatus])
  @@index([province])
  @@index([score])
  @@index([normalizedText], type: Hash)
  @@index([sourceId, duplicateOfId, createdAt])
  @@index([embeddingConfig, embeddingRetryAt])
  @@index([followUpAt])
  @@index([duplicateOfId])
}

model AiJob {
  id            String   @id @default(cuid())
  postId        String   @unique
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String   @default("")
  latencyMs     Int?
  queueWaitMs   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, updatedAt])
}

model OcrCache {
  imageHash String   @id
  text      String
  provider  String
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PreferenceWeight {
  id        String   @id @default(cuid())
  kind      String
  key       String
  weight    Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
}

model Summary {
  id        String   @id @default(cuid())
  day       String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Keyword {
  id        String   @id @default(cuid())
  word      String
  type      String
  createdAt DateTime @default(now())

  @@unique([word, type])
}

model Note {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  channel   String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  provider  String
  result    String
  createdAt DateTime @default(now())
}

model FetchTask {
  id         String    @id @default(cuid())
  sourceId   String
  source     Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     String    @default("pending")
  message    String    @default("")
  postsFound Int       @default(0)
  createdAt  DateTime  @default(now())
  pickedAt   DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

model ParseSample {
  id        String   @id @default(cuid())
  sourceUrl String
  payload   String
  postCount Int      @default(0)
  createdAt DateTime @default(now())
}

model FetchLog {
  id         String   @id @default(cuid())
  sourceId   String?
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  status     String
  message    String   @default("")
  postsFound Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ReplyTemplate {
  id         String   @id @default(cuid())
  name       String
  body       String
  categoryId String?
  sortOrder  Int      @default(0)
  useCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AutomationRule {
  id            String    @id @default(cuid())
  name          String
  enabled       Boolean   @default(true)
  categoryId    String?
  keywords      String    @default("")
  provinces     String    @default("")
  intent        String    @default("")
  minScore      Int       @default(0)
  actionNotify  Boolean   @default(true)
  actionSave    Boolean   @default(false)
  actionDismiss Boolean   @default(false)
  templateId    String?
  hitCount      Int       @default(0)
  lastHitAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hits          RuleHit[]
}

model RuleHit {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime       @default(now())

  @@unique([ruleId, postId])
  @@index([postId])
}

// Assisted-reply queue: MY-BOT fills a draft and opens the post; the owner presses send.
model ReplyQueueItem {
  id         String    @id @default(cuid())
  postId     String    @unique
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  sourceId   String
  authorKey  String    @default("")
  templateId String?
  text       String
  day        String
  status     String    @default("queued")
  openedAt   DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([day, status])
  @@index([status, createdAt])
  @@index([authorKey, createdAt])
}

// Facebook accounts seen by the read-only extension (id = the c_user value on facebook.com).
model FbAccount {
  id            String   @id
  name          String   @default("")
  browser       String   @default("")
  profileLabel  String   @default("")
  installId     String   @default("")
  loggedIn      Boolean  @default(true)
  postsCaptured Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lastSeenAt])
}

// One row per extension install (random id kept in chrome.storage). Updated every minute.
model ExtensionHeartbeat {
  id           String    @id
  version      String    @default("")
  browser      String    @default("")
  profileLabel String    @default("")
  enabled      Boolean   @default(false)
  fbLoggedIn   Boolean   @default(false)
  fbUserId     String?
  fbUserName   String    @default("")
  fbCheckedAt  DateTime?
  tabsJson     String    @default("[]")
  lastError    String    @default("")
  lastErrorAt  DateTime?
  lastPostAt   DateTime?
  postsSent    Int       @default(0)
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([lastSeenAt])
}
