{
  "manifest_version": 3,
  "name": "MY-BOT Lead Radar",
  "version": "1.10.19",
  "description": "อ่านโพสต์กลุ่มและ Marketplace ส่งเข้า MY-BOT และคอมเมนต์ผ่านหน้าจอ Facebook เฉพาะกฎที่เจ้าของเปิดและอุปกรณ์ที่อนุญาต ค่าเริ่มต้นไม่ส่ง รองรับ Dry Run โควตา และหยุดเมื่อพบข้อจำกัด ไม่ใช้ private API",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "idle"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://my-bot-e6bt.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MY-BOT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "identity.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://facebook.com/groups/*",
        "https://web.facebook.com/groups/*",
        "https://www.facebook.com/marketplace/*",
        "https://facebook.com/marketplace/*",
        "https://web.facebook.com/marketplace/*"
      ],
      "js": [
        "selectors.js",
        "fbtime.js",
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://my-bot-e6bt.onrender.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "mark-sent": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "บันทึกว่าส่งแล้ว (ลีดที่เปิดอยู่ในแท็บนี้)"
    },
    "mark-skip": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "ข้ามลีดที่เปิดอยู่ในแท็บนี้"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
