{
  "manifest_version": 3,
  "name": "MY-BOT Lead Radar",
  "version": "1.4.0",
  "description": "อ่านโพสต์กลุ่ม Facebook ที่คุณเป็นสมาชิก และประกาศ Marketplace ที่คุณเลือก แล้วส่งเข้า MY-BOT บนเครื่องตัวเอง อ่านอย่างเดียว: เลื่อนหน้าจออ่าน ไม่กดปุ่มบน Facebook ไม่โพสต์อัตโนมัติ ไม่กดส่งคอมเมนต์ และไม่เรียก API ภายในของ Facebook — ช่วยพิมพ์ข้อความตอบให้เฉพาะตอนที่คุณกด \"ตอบลีดนี้\" แล้วคุณกดส่งเอง",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MY-BOT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "identity.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://facebook.com/groups/*",
        "https://web.facebook.com/groups/*",
        "https://www.facebook.com/marketplace/*",
        "https://facebook.com/marketplace/*",
        "https://web.facebook.com/marketplace/*"
      ],
      "js": [
        "selectors.js",
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "mark-sent": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "บันทึกว่าส่งแล้ว (ลีดที่เปิดอยู่ในแท็บนี้)"
    },
    "mark-skip": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "ข้ามลีดที่เปิดอยู่ในแท็บนี้"
    }
  }
}
