# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าที่จำเป็น
# ฐานข้อมูล: Supabase Postgres (Project > Connect > Connection string)
# DATABASE_URL = Transaction pooler พอร์ต 6543 ต่อท้าย ?pgbouncer=true&connection_limit=5 (แอปใช้ตัวนี้)
# DIRECT_URL   = Session pooler พอร์ต 5432 (prisma migrate ใช้ตัวนี้)
# สคริปต์ติดตั้งจะถามแล้วกรอกให้เอง ห้าม commit ไฟล์ .env ที่มีรหัสผ่านจริง
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# ไฟล์ SQLite เก่า ใช้เฉพาะตอนย้ายข้อมูลครั้งเดียว: npm run db:migrate-from-sqlite
SQLITE_DATABASE_URL="file:../data/mybot.db"
PORT=8001

# Ollama บนเครื่องตัวเอง (ค่าเริ่มต้นของโหมดอัตโนมัติ)
# ว่างได้ ระบบจะลองพอร์ต 11434 ก่อน แล้วจึง 41434 (พอร์ต 11434 บน Windows บางเครื่องถูกกันไว้)
# ให้โปรเซส ollama serve (ไม่ใช่แอป) ได้ตัวแปร OLLAMA_MAX_LOADED_MODELS=2 และ OLLAMA_KEEP_ALIVE=30m
# สคริปต์ติดตั้งกับไฟล์ Startup ตั้งให้แล้ว แล้วต้องเปิด ollama serve ใหม่หนึ่งครั้ง
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_EMBED_MODEL="bge-m3"
# 1 = ข้าม Ollama (บนคลาวด์ ไม่ตั้งก็ได้ ระบบตรวจเอง)
OLLAMA_DISABLED=
GEMINI_EMBED_MODEL="text-embedding-004"

# เว้นว่างได้ ระบบจะข้ามไปตัวถัดไป ใส่ใน .env หรือในหน้าตั้งค่าก็ได้
GEMINI_API_KEY=""
GROQ_API_KEY=""
# ไม่บังคับ ถ้าไม่ใส่หรือชื่อนี้ไม่มีในบัญชี จะเลือกจากรายการโมเดลของบัญชีเอง
GROQ_MODEL="openai/gpt-oss-120b"

# แจ้งเตือนภายนอก ไม่บังคับ
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_USER_ID=""
DISCORD_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL_TO=""

# Encrypts AI provider API keys stored in the database (any random string, 16+ chars). Changing it makes saved keys unreadable.
AI_KEY_SECRET=""
