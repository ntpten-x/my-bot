# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าที่จำเป็น
DATABASE_URL="file:../data/mybot.db"
PORT=8001

# Ollama บนเครื่องตัวเอง (ค่าเริ่มต้นของโหมดอัตโนมัติ)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_EMBED_MODEL="bge-m3"
GEMINI_EMBED_MODEL="text-embedding-004"

# เว้นว่างได้ ระบบจะข้ามไปตัวถัดไป ใส่ใน .env หรือในหน้าตั้งค่าก็ได้
GEMINI_API_KEY=""
GROQ_API_KEY=""
# ไม่บังคับ ถ้าไม่ใส่หรือชื่อนี้ไม่มีในบัญชี จะเลือกจากรายการโมเดลของบัญชีเอง
GROQ_MODEL="openai/gpt-oss-120b"

# แจ้งเตือนภายนอก ไม่บังคับ
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_USER_ID=""
DISCORD_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL_TO=""
