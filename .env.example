# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าที่จำเป็น
# ฐานข้อมูล: Supabase Postgres (Project > Connect > Connection string)
# DATABASE_URL = Transaction pooler พอร์ต 6543 ต่อท้าย ?pgbouncer=true&connection_limit=5 (แอปใช้ตัวนี้)
# DIRECT_URL   = Session pooler พอร์ต 5432 (prisma migrate ใช้ตัวนี้)
# สคริปต์ติดตั้งจะถามแล้วกรอกให้เอง ห้าม commit ไฟล์ .env ที่มีรหัสผ่านจริง
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional test database only. Never point this at production; suites create/drop test_* schemas.
TEST_DATABASE_URL=""
# Optional connection pool override (explicit connection_limit in DATABASE_URL wins).
DB_CONNECTION_LIMIT="8"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only Supabase Storage for message images (bucket message-images). Never put in NEXT_PUBLIC_*.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# ไฟล์ SQLite เก่า ใช้เฉพาะตอนย้ายข้อมูลครั้งเดียว: npm run db:migrate-from-sqlite
SQLITE_DATABASE_URL="file:../data/mybot.db"
PORT=8001

# แจ้งเตือนภายนอก ไม่บังคับ
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_USER_ID=""
DISCORD_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL_TO=""

# Encrypts notification credentials and protects backups. Legacy variable name; not an AI requirement. Keep the existing value on upgrades.
AI_KEY_SECRET=""

# Auto Comment: server-only Meta app credentials; engine defaults OFF + Dry Run.
# Page/User tokens are encrypted in Settings using AI_KEY_SECRET. Never use NEXT_PUBLIC_.
FACEBOOK_APP_ID=
FACEBOOK_APP_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v25.0

# Required for every password recovery and production setup (including localhost).
# Choose locally in server environment; at least 24 bytes. Never send through chat.
BOOTSTRAP_TOKEN=""
# HTTPS PUT directory accepting encrypted backup files; optional bearer token.
BACKUP_UPLOAD_URL=""
BACKUP_UPLOAD_TOKEN=""
# Separate backup key preferred; defaults to AI_KEY_SECRET. Keep the restore key offline.
BACKUP_ENCRYPTION_KEY=""
# Additional public image CDN domains, comma-separated; default fbcdn.net,fbsbx.com.
IMAGE_ALLOWED_HOSTS=""
# Optional: pin MY-BOT Desktop ZIP origin (e.g. https://my-bot-e6bt.onrender.com). When set, download refuses other hosts.
DESKTOP_PUBLIC_ORIGIN=""

# Optional canonical origin for authentication CSRF validation (HTTPS in production).
AUTH_URL=""

# Security rollout: set only after local + Render run the same verified build.
SECURITY_RELEASE_READY="0"
# Default: legacy bearer sessions and shared extension token are rejected.
AUTH_ALLOW_LEGACY_SESSIONS="0"
AUTH_ALLOW_LEGACY_EXTENSION_TOKEN="0"
# Number of explicitly trusted reverse proxies (0 ignores forwarded client identity).
TRUST_PROXY_HOPS="0"
# Persistent server-only HMAC key, at least 32 characters. Shared by all web/worker hosts.
SECURITY_AUDIT_KEY=""
# Optional private directory populated by a Vault/KMS agent; files must be owned by the app user, mode 0600.
SECRET_STORE_DIRECTORY=""
# MFA is required after the all-host release gate opens; 0 is an explicit administrator break-glass override.
SECURITY_REQUIRE_MFA="1"
# Optional dedicated session signing key; otherwise domain-separated HMAC uses AI_KEY_SECRET.
SESSION_SIGNING_KEY=""
# JSON arrays in the secret store/environment; retain only during coordinated key rotation.
AI_KEY_SECRET_PREVIOUS='[]'
SECURITY_AUDIT_PREVIOUS_KEYS='[]'
